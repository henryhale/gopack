{
  "name": "gopack",
  "private": true,
  "version": "1.0.3",
  "description": "Builds and packages a golang project, outputting the binaries for multiple platforms.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -b && ncc build out/index.js -o dist",
    "release": "pnpm build && git add . && git commit -m \"build: update dist bundle\" && git push",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": {
    "name": "Henry Hale",
    "url": "https://github.com/henryhale"
  },
  "license": "ISC",
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^7.0.2"
  }
}
